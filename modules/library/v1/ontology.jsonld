{"@context":{"owl":"http://www.w3.org/2002/07/owl#","rdf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#","rdfs":"http://www.w3.org/2000/01/rdf-schema#","label":"rdfs:label","comment":"rdfs:comment","subClassOf":{"@id":"rdfs:subClassOf","@type":"@id"}},"@graph":[{"@id":"https://zenith-research.ca/ontology/zenith/library/v1","@type":"owl:Ontology","label":"Zenith library connections","comment":"Hosted library metadata and evidence-qualified graph assertions. This profile does not approve draft source semantics or prescribe user interfaces."},{"@id":"https://zenith-research.ca/ontology/zenith/library/v1/terms/OntologyFamily","@type":"owl:Class","label":"OntologyFamily","comment":"A library-authored grouping of source modules, not a claim that the original source declared an umbrella owl:Ontology."},{"@id":"https://zenith-research.ca/ontology/zenith/library/v1/terms/LibrarySelection","@type":"owl:Class","label":"LibrarySelection","comment":"An exact published selection of source revisions and disclosed metadata."},{"@id":"https://zenith-research.ca/ontology/zenith/library/v1/terms/DefinitionOccurrence","@type":"owl:Class","label":"DefinitionOccurrence","comment":"One definition in an exact source/profile context; its semantic identity is preserved separately."},{"@id":"https://zenith-research.ca/ontology/zenith/library/v1/terms/GraphAssertion","@type":"owl:Class","label":"GraphAssertion","comment":"An evidence-qualified reified RDF statement; status distinguishes source declarations, proposals and library selection.","subClassOf":"http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"},{"@id":"https://zenith-research.ca/ontology/zenith/library/v1/terms/ProposedDomainClassification","@type":"owl:Class","label":"ProposedDomainClassification","comment":"A release-scoped proposed domain label; matching labels do not merge meanings."},{"@id":"https://zenith-research.ca/ontology/zenith/library/v1/terms/includes","@type":"owl:ObjectProperty","label":"includes","comment":"Members