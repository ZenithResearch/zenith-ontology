      "properties": {
        "type": {
          "const": "evidence.CaptureEvidence"
        }
      },
      "unevaluatedProperties": false,
      "description": "Who supplied/captured which exact fields, at which revisions; authored data is not entered again into each document.",
      "x-invariants": []
    },
    "DerivationEvidenceShape": {
      "type": "object",
