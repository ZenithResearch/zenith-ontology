{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zenith:ontology-review:shared:0.1.0:evidence",
  "title": "Provenance, verification & review · noncanonical draft",
  "$defs": {
    "ChangedField": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/FieldPointer"
        },
        "after": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/FieldPointer"
        },
        "before_value": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ValueSnapshot"
        },
        "after_value": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ValueSnapshot"
        },
        "value_schema_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
        }
      },
      "required": [
        "before",
        "after",
        "before_value",
        "after_value",
        "value_schema_ref"
      ],
      "additionalProperties": false,
      "description": "Exact before/after field values with revision and schema bindings. Equal values are not a changed field."
    },
    "DependencyStep": {
      "type": "object",
      "properties": {
        "from_pointer": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/FieldPointer"
        },
        "to_pointer": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/FieldPointer"
        },
        "edge_kind": {
          "type": "string",
          "enum": [
            "declared_input",
            "observed_read",
            "exact_copy",
            "observed_derivation"
          ]
        },
        "evidence_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
        }
      },
      "required": [
        "from_pointer",
        "to_pointer",
        "edge_kind",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "description": "One explicit field dependency step; edge type controls what can be inferred."
    },
    "SourceRevisionShape": {
      "type": "object",
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RecordBase"
        }
      ],
      "properties": {
        "subject_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/OwnedRecordRef"
        },
        "source_version": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RevisionQualifiedRef"
        },
        "content_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
        },
        "value_schema_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
        },
        "coverage": {
          "type": "string",
          "enum": [
            "full_record",
            "field_projection"
          ]
        },
        "included_pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "previous_ref": {
          "allOf": [
            {
              "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RevisionQualifiedRef"
            }
          ],
          "x-target-types": [
            "evidence.SourceRevision"
          ]
        }
      },
      "required": [
        "subject_ref",
        "source_version",
        "content_ref",
        "value_schema_ref",
        "coverage"
      ]
    },
    "SourceRevision": {
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:evidence#/$defs/SourceRevisionShape"
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "field_projection"
              }
            }
          },
          "then": {
            "required": [
              "included_pointers"
            ]
          }
        }
      ],
      "properties": {
        "type": {
          "const": "evidence.SourceRevision"
        }
      },
      "unevaluatedProperties": false,
      "description": "Immutable source snapshot/projection evidence, distinct from the identity described and its mutable source store. Partial field coverage must be declared.",
      "x-invariants": []
    },
    "CaptureEvidenceShape": {
      "type": "object",
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RecordBase"
        }
      ],
      "properties": {
        "field_pointers": {
          "type": "array",
          "items": {
            "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/FieldPointer"
