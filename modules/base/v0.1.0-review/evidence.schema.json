        "evidence_strength": {
          "type": "string",
          "enum": [
            "observed_read",
            "declared_dependency",
            "exact_copy",
            "not_instrumented"
          ]
        },
        "evidence_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
        }
      },
      "required": [
        "input_pointers",
        "output_pointer",
        "method",
        "evidence_strength",
