        }
      ]
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events",
      "@type": "owl:Ontology",
      "rdfs:label": "Events & source registry · review only",
      "owl:imports": [
        {
          "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence"
        },
        {
          "@id": "urn:zenith:ontology-review:shared:0.1.0:foundation"
        },
