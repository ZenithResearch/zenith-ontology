          "@id": "urn:zenith:ontology-review:shared:0.1.0:planning"
        },
        {
          "@id": "https://zenith-research.ca/ontology/v0.8.0/ontology.jsonld"
        }
      ]
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution",
      "@type": "owl:Ontology",
      "rdfs:label": "Execution methods & evidence · review only",
      "owl:imports": [
        {
          "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence"
        },
        {
          "@id": "urn:zenith:ontology-review:shared:0.1.0:foundation"
        },
