          "@id": "urn:zenith:ontology-review:shared:0.1.0:resources"
        },
        {
          "@id": "https://zenith-research.ca/ontology/v0.8.0/ontology.jsonld"
        }
      ]
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:planning",
      "@type": "owl:Ontology",
      "rdfs:label": "Planning · review only",
      "owl:imports": [
        {
          "@id": "urn:zenith:ontology-review:shared:0.1.0:directory"
        },
        {
          "@id": "urn:zenith:ontology-review:shared:0.1.0:foundation"
        },
        {
          "@id": "urn:zenith:ontology-review:shared:0.1.0:resources"
        },
        {
          "@id": "https://zenith-research.ca/ontology/v0.8.0/ontology.jsonld"
        }
      ]
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:authority#VerifiedOperationAuthorityReference",
      "@type": "owl:Class",
      "rdfs:label": "VerifiedOperationAuthorityReference",
      "rdfs:comment": "Reference to an existing receiver-verified context/receipt; this record cannot itself authenticate, issue, broaden or delegate authority."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:authority#ContributionPolicyReference",
      "@type": "owl:Class",
      "rdfs:label": "ContributionPolicyReference",
      "rdfs:comment": "Descriptive contribution policy/intent. Existing receiver authority must be checked for every accepted operation; no local may_redelegate flag mints a delegation."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:authority#DisclosurePolicyReference",
      "@type": "owl:Class",
      "rdfs:label": "DisclosurePolicyReference",
      "rdfs:comment": "Pinned receiver-owned disclosure policy reference. The policy is interpreted and enforced by its owner, not by ontology membership."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#ResourceInstance",
      "@type": "owl:Class",
      "rdfs:label": "ResourceInstance",
      "rdfs:comment": "Concrete resource identity; never equated with a software Agent or the Artifact snapshot describing it."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#ComputeResource",
      "@type": "owl:Class",
      "rdfs:label": "ComputeResource",
      "rdfs:comment": "Resource specialization. Installation identity can be local; it is not hardware attestation or a globally verified machine ID.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#ResourceInstance"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#ResourceRequirement",
      "@type": "owl:Class",
      "rdfs:label": "ResourceRequirement",
      "rdfs:comment": "A capability/quantity/time need. Runtime eligibility resource strings are not capacity, stock, price or reservations."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#AvailabilityAssertion",
      "@type": "owl:Class",
      "rdfs:label": "AvailabilityAssertion",
      "rdfs:comment": "Sourced availability assertion for exactly one person/organization/agent or resource; it does not confirm a booking."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#ResourceOffer",
      "@type": "owl:Class",
      "rdfs:label": "ResourceOffer",
      "rdfs:comment": "Commercial/crew-provided offer for an existing unit. Provider, physical item, capability and availability remain separate."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#Allocation",
      "@type": "owl:Class",
      "rdfs:label": "Allocation",
      "rdfs:comment": "Selection of an exact offer against an exact requirement, not proof of reservation or observed use."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#Reservation",
      "@type": "owl:Class",
      "rdfs:label": "Reservation",
      "rdfs:comment": "Reservation evidence/profile of the owning booking provider; no shadow booking writer is introduced."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:resources#AllocationObservation",
      "@type": "owl:Class",
      "rdfs:label": "AllocationObservation",
      "rdfs:comment": "Immutable evidence of selection/reservation/use; a selection cannot be relabeled as actual use.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#OrganizationUnit",
      "@type": "owl:Class",
      "rdfs:label": "OrganizationUnit",
      "rdfs:comment": "Scoped organizational function/team. Film department definitions and craft groups classify it; they are not its parent organizations or mandatory hires."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#ScopedPost",
      "@type": "owl:Class",
      "rdfs:label": "ScopedPost",
      "rdfs:comment": "Accountable post/seat, independent of its occupant. reports_to is a dated reporting relation, not role inheritance or permission."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#PostAssignment",
      "@type": "owl:Class",
      "rdfs:label": "PostAssignment",
      "rdfs:comment": "One person occupying one scoped post for a period. Multiple occupations reference the same Person."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#PostRequirement",
      "@type": "owl:Class",
      "rdfs:label": "PostRequirement",
      "rdfs:comment": "Staffing need; an unfilled post creates no fake Person or accepted booking."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#ResponsibilityBinding",
      "@type": "owl:Class",
      "rdfs:label": "ResponsibilityBinding",
      "rdfs:comment": "Scoped accountability/contribution. Collaborative input can have several people; responsibilities and delegation are not credentials."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#BookingCommitment",
      "@type": "owl:Class",
      "rdfs:label": "BookingCommitment",
      "rdfs:comment": "Shared semantic profile referencing the existing booking owner. Cast engagement composes it with Person and film character/performance scope."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#RepresentationBinding",
      "@type": "owl:Class",
      "rdfs:label": "RepresentationBinding",
      "rdfs:comment": "Sourced representation relationship; agency/guardian/representative identity does not imply operation authority."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#ExternalSubjectBinding",
      "@type": "owl:Class",
      "rdfs:label": "ExternalSubjectBinding",
      "rdfs:comment": "Entity-to-provider-subject binding with evidence. Connected-account descriptors, key control, membership and authorization stay independent; no secrets are stored."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#PersonInterfaceBinding",
      "@type": "owl:Class",
      "rdfs:label": "PersonInterfaceBinding",
      "rdfs:comment": "Contact/application interface selected for a Person. A hired person need not have an application account; endpoint references are policy-limited."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:directory#RestrictedContactProjection",
      "@type": "owl:Class",
      "rdfs:label": "RestrictedContactProjection",
      "rdfs:comment": "Restricted contact view, referencing a reviewed source and policy. No raw contact data or credential is embedded in the public ontology.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#SourceRevision",
      "@type": "owl:Class",
      "rdfs:label": "SourceRevision",
      "rdfs:comment": "Immutable source snapshot/projection evidence, distinct from the identity described and its mutable source store. Partial field coverage must be declared.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#CaptureEvidence",
      "@type": "owl:Class",
      "rdfs:label": "CaptureEvidence",
      "rdfs:comment": "Who supplied/captured which exact fields, at which revisions; authored data is not entered again into each document.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#DerivationEvidence",
      "@type": "owl:Class",
      "rdfs:label": "DerivationEvidence",
      "rdfs:comment": "Exact declared/observed field lineage. Only observed evidence supports a claim of actual reads or executed causation.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ObservationAssertion",
      "@type": "owl:Class",
      "rdfs:label": "ObservationAssertion",
      "rdfs:comment": "Sourced observation/assertion. An event occurrence can carry this assertion; transport is not its truth or mutation authority.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#VerificationAssertion",
      "@type": "owl:Class",
      "rdfs:label": "VerificationAssertion",
      "rdfs:comment": "Revision-bound verification result, not authorization, approval or completion by itself.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#CompletionAssertion",
      "@type": "owl:Class",
      "rdfs:label": "CompletionAssertion",
      "rdfs:comment": "Assertion that a scoped result is done; data/readiness/acceptance gates are independently evaluated.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ReadinessEvidence",
      "@type": "owl:Class",
      "rdfs:label": "ReadinessEvidence",
      "rdfs:comment": "Domain readiness evidence. It does not replace Devgraph ReadinessAssessment or confer permission to run/issue.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ScopedDecision",
      "@type": "owl:Class",
      "rdfs:label": "ScopedDecision",
      "rdfs:comment": "Sourced decision on exact revisions; existing Devgraph Decision retains its Work governance semantics.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ReviewDecision",
      "@type": "owl:Class",
      "rdfs:label": "ReviewDecision",
      "rdfs:comment": "Review disposition is distinct from issue approval or recipient acceptance.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ScopedDecision"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#RevisionApproval",
      "@type": "owl:Class",
      "rdfs:label": "RevisionApproval",
      "rdfs:comment": "Exact revision/content approval under a pinned policy; effects require receiver verification of the referenced authority.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ScopedDecision"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#AcceptanceDecision",
      "@type": "owl:Class",
      "rdfs:label": "AcceptanceDecision",
      "rdfs:comment": "Recipient decision for an exact submission/package, separate from transport acknowledgment.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ScopedDecision"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#AdvisoryReviewSession",
      "@type": "owl:Class",
      "rdfs:label": "AdvisoryReviewSession",
      "rdfs:comment": "Discussion/session organization; not an approval or automatic source edit."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#AdvisoryNote",
      "@type": "owl:Class",
      "rdfs:label": "AdvisoryNote",
      "rdfs:comment": "Revision-bound advisory note; source revisions change only through accepted owner commands.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ReviewResponse",
      "@type": "owl:Class",
      "rdfs:label": "ReviewResponse",
      "rdfs:comment": "Author response with explicit resulting revisions when any exist; accepting a note does not invent a revision.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#ChangeImpactExplanation",
      "@type": "owl:Class",
      "rdfs:label": "ChangeImpactExplanation",
      "rdfs:comment": "Explainable impact, retaining the difference between reachability, actual execution, changed output and held content.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:evidence#EvidenceGap",
      "@type": "owl:Class",
      "rdfs:label": "EvidenceGap",
      "rdfs:comment": "Explicit missing/irrelevant evidence, not a fabricated environment observation or machine binding.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#DocumentRevision",
      "@type": "owl:Class",
      "rdfs:label": "DocumentRevision",
      "rdfs:comment": "Immutable document content revision; film kinds, templates and their required inputs remain film-owned.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#Rendition",
      "@type": "owl:Class",
      "rdfs:label": "Rendition",
      "rdfs:comment": "Rendered representation of an exact document revision; it is not a new editable source of facts.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#PDFRendition",
      "@type": "owl:Class",
      "rdfs:label": "PDFRendition",
      "rdfs:comment": "PDF specialization. PDF creation alone does not approve, issue or dispatch a document.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#Rendition"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#AuthoringCandidate",
      "@type": "owl:Class",
      "rdfs:label": "AuthoringCandidate",
      "rdfs:comment": "Manual or tool-produced candidate, validated against domain schemas; not a second source store or an automatic write.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#PackDefinition",
      "@type": "owl:Class",
      "rdfs:label": "PackDefinition",
      "rdfs:comment": "Reusable pack recipe. Film defines camera/location/cast pack content; shared code owns composition mechanics."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#SectionDefinition",
      "@type": "owl:Class",
      "rdfs:label": "SectionDefinition",
      "rdfs:comment": "Reusable section contract with typed inputs, conditional applicability and disclosure requirements."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#PackInstance",
      "@type": "owl:Class",
      "rdfs:label": "PackInstance",
      "rdfs:comment": "Scoped logical pack identity, not the immutable content revision."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#PackRevision",
      "@type": "owl:Class",
      "rdfs:label": "PackRevision",
      "rdfs:comment": "Immutable composed document revision with revision-bound sections/inclusions; it does not overwrite included source objects.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#DocumentRevision"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#Section",
      "@type": "owl:Class",
      "rdfs:label": "Section",
      "rdfs:comment": "Materialized section of a composition. Missing data remains explicit rather than re-entered as guessed text.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#RevisionInclusion",
      "@type": "owl:Class",
      "rdfs:label": "RevisionInclusion",
      "rdfs:comment": "An ordered inclusion references an exact revision, avoiding another writable copy of the included source.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#RedactionManifest",
      "@type": "owl:Class",
      "rdfs:label": "RedactionManifest",
      "rdfs:comment": "Evidence of excluded fields under a pinned policy; the raw restricted values need not be repeated in the manifest.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:documents#RecipientProjection",
      "@type": "owl:Class",
      "rdfs:label": "RecipientProjection",
      "rdfs:comment": "Immutable recipient-specific view of one master revision. Policy and actual receiver authority are separate from role or contact membership.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:handoff#DispatchIntent",
      "@type": "owl:Class",
      "rdfs:label": "DispatchIntent",
      "rdfs:comment": "Versioned outbound intent for an exact permitted payload; no dispatch occurs merely because an intent exists."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:handoff#DistributionAttempt",
      "@type": "owl:Class",
      "rdfs:label": "DistributionAttempt",
      "rdfs:comment": "Transport evidence referencing the canonical effect/attempt when Runtime executes it. External/manual transport may lack a Runtime effect."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:handoff#Acknowledgment",
      "@type": "owl:Class",
      "rdfs:label": "Acknowledgment",
      "rdfs:comment": "Acknowledgment of the exact personal view, not final recipient acceptance or proof of source correctness.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:handoff#ManifestItem",
      "@type": "owl:Class",
      "rdfs:label": "ManifestItem",
      "rdfs:comment": "Exact package item identity and byte descriptor/checksum; copying and custody remain separate from the source identity.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:handoff#DeliveryEvidence",
      "@type": "owl:Class",
      "rdfs:label": "DeliveryEvidence",
      "rdfs:comment": "Receiving/transport observation. Not Devgraph EventReceipt, Runtime Receipt, approval or recipient acceptance.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:handoff#ReceivingEvidence",
      "@type": "owl:Class",
      "rdfs:label": "ReceivingEvidence",
      "rdfs:comment": "Byte-level receiving/checksum evidence, distinct from creative/technical acceptance.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:planning#DomainMilestone",
      "@type": "owl:Class",
      "rdfs:label": "DomainMilestone",
      "rdfs:comment": "Domain planning checkpoint; an optional film specialization. Not Devgraph Work Milestone or an execution StepRun."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:planning#ScopedPrecedence",
      "@type": "owl:Class",
      "rdfs:label": "ScopedPrecedence",
      "rdfs:comment": "Explicit temporal planning constraint; not graph containment, data flow or evidence that a worker executed."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EventOccurrence",
      "@type": "owl:Class",
      "rdfs:label": "EventOccurrence",
      "rdfs:comment": "Logical domain occurrence, separate from an envelope delivery and consumer processing state."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EnvelopeBinding",
      "@type": "owl:Class",
      "rdfs:label": "EnvelopeBinding",
      "rdfs:comment": "Retains exact transport bytes and links retries/deliveries to one logical occurrence without changing the Hub wire shape."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#ScheduledTrigger",
      "@type": "owl:Class",
      "rdfs:label": "ScheduledTrigger",
      "rdfs:comment": "Scheduled logical occurrence; recurrence/timezone/cutoff rules belong in its pinned trigger policy, not a transport topic name.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EventOccurrence"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#ObservationOccurrence",
      "@type": "owl:Class",
      "rdfs:label": "ObservationOccurrence",
      "rdfs:comment": "Occurrence carrying a sourced assertion; accepted source mutation requires the separate owner command and authority checks.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EventOccurrence"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#CompletionOccurrence",
      "@type": "owl:Class",
      "rdfs:label": "CompletionOccurrence",
      "rdfs:comment": "Typed occurrence referencing the actual assertion/intent/evidence; it does not execute or authorize the downstream operation.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EventOccurrence"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#ApprovalOccurrence",
      "@type": "owl:Class",
      "rdfs:label": "ApprovalOccurrence",
      "rdfs:comment": "Typed occurrence referencing the actual assertion/intent/evidence; it does not execute or authorize the downstream operation.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EventOccurrence"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#DispatchOccurrence",
      "@type": "owl:Class",
      "rdfs:label": "DispatchOccurrence",
      "rdfs:comment": "Typed occurrence referencing the actual assertion/intent/evidence; it does not execute or authorize the downstream operation.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EventOccurrence"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#AcknowledgementOccurrence",
      "@type": "owl:Class",
      "rdfs:label": "AcknowledgementOccurrence",
      "rdfs:comment": "Typed occurrence referencing the actual assertion/intent/evidence; it does not execute or authorize the downstream operation.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EventOccurrence"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#TransferVerificationOccurrence",
      "@type": "owl:Class",
      "rdfs:label": "TransferVerificationOccurrence",
      "rdfs:comment": "Typed occurrence referencing the actual assertion/intent/evidence; it does not execute or authorize the downstream operation.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:events#EventOccurrence"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#ConsumerDecision",
      "@type": "owl:Class",
      "rdfs:label": "ConsumerDecision",
      "rdfs:comment": "Consumer-owned processing decision. Domain commands and Runtime records retain their actual mutation/execution state."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:events#TopicDefinition",
      "@type": "owl:Class",
      "rdfs:label": "TopicDefinition",
      "rdfs:comment": "Pinned topic/schema/source policy registry. A prefix or source string is not membership, tenancy or permission."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#ImplementationArtifact",
      "@type": "owl:Class",
      "rdfs:label": "ImplementationArtifact",
      "rdfs:comment": "Exact code/procedure revision and entry point; a skill/plugin name alone does not establish installation, compatibility or authority.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#ToolRelease",
      "@type": "owl:Class",
      "rdfs:label": "ToolRelease",
      "rdfs:comment": "Pinned versioned tool/skill/procedure artifact. Tool user, release and invocation remain separate.",
      "rdfs:subClassOf": {
        "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#ImplementationArtifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#ExecutionEnvironmentRequirement",
      "@type": "owl:Class",
      "rdfs:label": "ExecutionEnvironmentRequirement",
      "rdfs:comment": "Declared environment constraints, not an observation of a particular worker or machine."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#EnvironmentSnapshot",
      "@type": "owl:Class",
      "rdfs:label": "EnvironmentSnapshot",
      "rdfs:comment": "Observed environment evidence. Current DayCall is self_reported_local; no historical machine/version is filled from today.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#InvocationEvidence",
      "@type": "owl:Class",
      "rdfs:label": "InvocationEvidence",
      "rdfs:comment": "Supplementary invocation evidence referencing the actual Attempt; no second attempt, lease, executor claim or receipt.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#ExecutionPolicy",
      "@type": "owl:Class",
      "rdfs:label": "ExecutionPolicy",
      "rdfs:comment": "Versioned implementation selection preserving input/output/acceptance contracts; manual-to-Hermes changes method, not record ownership or authorization."
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#DecompositionMapping",
      "@type": "owl:Class",
      "rdfs:label": "DecompositionMapping",
      "rdfs:comment": "Refinement/port mapping, not containment-as-execution or a second Runtime compiler.",
      "rdfs:subClassOf": {
        "@id": "https://zenith-research.ca/ontology/terms/Artifact"
      }
    },
    {
      "@id": "urn:zenith:ontology-review:shared:0.1.0:execution#CapabilityConcept",
      "@type": "owl:Class",
      "rdfs:label": "CapabilityConcept",
      "rdfs:comment": "Capability descriptor. Claimed ability, qualification, capacity and verified authority remain independent."
    },
