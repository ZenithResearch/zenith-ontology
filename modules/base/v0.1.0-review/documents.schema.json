            "kind": {
              "const": "Attempt"
            }
          },
          "x-target-types": [
            "provider:process-runtime:Attempt"
          ]
        }
      },
      "required": [
        "document_revision_ref",
        "content_ref",
        "template_ref"
      ]
    },
    "Rendition": {
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:documents#/$defs/RenditionShape"
        }
      ],
      "properties": {
        "type": {
          "const": "documents.Rendition"
        }
      },
      "unevaluatedProperties": false,
      "description": "Rendered representation of an exact document revision; it is not a new editable source of facts.",
      "x-invariants": []
    },
    "PDFRenditionShape": {
      "type": "object",
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RecordBase"
        },
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:documents#/$defs/RenditionShape"
        }
      ],
      "properties": {
        "format": {
          "const": "application/pdf"
        },
        "content_ref": {
          "allOf": [
            {
              "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
            }
          ],
          "properties": {
            "media_type": {
              "const": "application/pdf"
            }
          }
        }
      },
      "required": [
        "format",
        "content_ref"
      ]
    },
    "PDFRendition": {
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:documents#/$defs/PDFRenditionShape"
        }
      ],
      "properties": {
        "type": {
          "const": "documents.PDFRendition"
        }
      },
      "unevaluatedProperties": false,
      "description": "PDF specialization. PDF creation alone does not approve, issue or dispatch a document.",
      "x-invariants": []
    },
    "AuthoringCandidateShape": {
      "type": "object",
