{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zenith:ontology-review:shared:0.1.0:documents",
  "title": "Documents & composition · noncanonical draft",
  "$defs": {
    "CandidateFieldUpdate": {
