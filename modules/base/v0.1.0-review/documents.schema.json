        "target": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/FieldPointer"
        },
        "value": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ValueSnapshot"
        },
        "value_schema_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
        }
      },
      "required": [
        "target",
        "value",
        "value_schema_ref"
      ],
      "additionalProperties": false,
      "description": "Proposed field value with exact expected revision; accepted source commands remain owner-validated."
    },
    "DocumentRevisionShape": {
      "type": "object",
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RecordBase"
        }
      ],
      "properties": {
        "document_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/OwnedRecordRef"
        },
        "document_kind_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/OwnedRecordRef"
        },
        "content_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
        },
        "content_schema_ref": {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/ArtifactRef"
        },
        "source_bindings": {
          "type": "array",
          "items": {
            "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/FieldPointer"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "author_post_ref": {
          "allOf": [
            {
              "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/OwnedRecordRef"
            }
          ],
          "x-target-types": [
            "directory.ScopedPost"
          ]
        },
        "approval_ref": {
          "allOf": [
            {
              "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RevisionQualifiedRef"
            }
          ],
          "x-target-types": [
            "evidence.RevisionApproval"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "approved",
            "issued"
          ]
        },
        "issuing_authority_ref": {
          "allOf": [
            {
              "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/OwnedRecordRef"
            }
          ],
          "x-target-types": [
            "authority.VerifiedOperationAuthorityReference"
          ]
        }
      },
      "required": [
        "document_ref",
        "document_kind_ref",
        "content_ref",
        "source_bindings",
        "state"
      ]
    },
    "DocumentRevision": {
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:documents#/$defs/DocumentRevisionShape"
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "approved",
                  "issued"
                ]
              }
            }
          },
          "then": {
            "required": [
              "approval_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "issued"
              }
            }
          },
          "then": {
            "required": [
              "issuing_authority_ref"
            ]
          }
        }
      ],
      "properties": {
        "type": {
          "const": "documents.DocumentRevision"
        }
      },
      "unevaluatedProperties": false,
      "description": "Immutable document content revision; film kinds, templates and their required inputs remain film-owned.",
      "x-invariants": [
        "Approved/issued states require an exact approval reference. Issued state also requires issuing_authority_ref; actual issue remains a receiver-owned operation."
      ]
    },
    "RenditionShape": {
      "type": "object",
      "allOf": [
        {
          "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RecordBase"
        }
      ],
      "properties": {
        "document_revision_ref": {
          "allOf": [
            {
              "$ref": "urn:zenith:ontology-review:shared:0.1.0:foundation#/$defs/RevisionQualifiedRef"
