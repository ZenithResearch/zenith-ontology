            "https://zenith-research.ca/ontology/terms/Entity",
            "https://zenith-research.ca/ontology/terms/Person",
            "https://zenith-research.ca/ontology/terms/Agent",
            "https://zenith-research.ca/ontology/terms/Organization"
          ]
