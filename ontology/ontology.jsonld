      "@graph": [
        {
          "@id": "https://zenith-research.ca/ontology/publication/v0.1.0/ontology.jsonld",
          "@type": "owl:Ontology",
          "rdfs:label": "Zenith publication extension",
          "owl:versionInfo": "0.1.0",
          "rdfs:comment": "Review draft owned by Zenith. Describes release evidence, comparisons, schemas and taxonomy; does not amend historical Devgraph bundles or confer approval."
        },
        {
          "@id": "https://zenith-research.ca/ontology/publication/v0.1.0/terms/PublicationEntity",
          "@type": "rdfs:Class",
          "rdfs:label": "Publication entity"
        },
        {
          "@id": "https://zenith-research.ca/ontology/publication/v0.1.0/terms/ReleaseChange",
          "@type": "rdfs:Class",
          "rdfs:label": "Release change",
          "rdfs:subClassOf": {
            "@id": "https://zenith-research.ca/ontology/publication/v0.1.0/terms/PublicationEntity"
          }
        },
        {
          "@id": "https://zenith-research.ca/ontology/publication/v0.1.0/terms/ReleaseArtifact",
          "@type": "rdfs:Class",
          "rdfs:label": "ReleaseArtifact",
          "rdfs:comment": "An immutable file within one source release, identified by its URL and checksum.",
          "rdfs:subClassOf": {
            "@id": "https://zenith-research.ca/ontology/publication/v0.1.0/terms/PublicationEntity"
          },
          "rdfs:isDefinedBy": {
