          }
        },
        {
          "@id": "https://zenith-research.ca/ontology/publication/v0.1.0/terms/SourceCommit",
          "@type": "rdfs:Class",
          "rdfs:label": "SourceCommit",
          "rdfs:comment": "A source revision providing publication provenance, distinct from a semantic release or approval.",
          "rdfs:subClassOf": {
            "@id": "https://zenith-research.ca/ontology/publication/v0.1.0/terms/PublicationEntity"
          },
          "rdfs:isDefinedBy": {
