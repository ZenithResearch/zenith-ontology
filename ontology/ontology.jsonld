  "@graph": [
    {
      "@id": "urn:zenith:ontology-review:composed:0.1.0",
      "@type": "owl:Ontology",
      "rdfs:label": "Zenith shared model \u2014 composed source review",
      "owl:versionInfo": "0.1.0-review.1",
      "rdfs:comment": "One Zenith model family containing shared domains, Product, publication/release and library profiles. Review namespace; not a replacement for existing provider ontologies. Component source claims and namespaces remain unchanged.",
      "owl:imports": [
        {
          "@id": "urn:zenith:ontology-review:shared:0.1.0:foundation"
